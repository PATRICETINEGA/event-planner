generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        String   // YYYY-MM-DD
  location    String?
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
}
